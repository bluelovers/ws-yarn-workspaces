{
  "name": "ws-create-yarn-workspaces",
  "version": "1.0.0",
  "private": true,
  "keywords": [
    "yarn",
    "yarn-tool",
    "pnpm",
    "monorepo",
    "workspaces",
    "npm",
    "lerna",
    "pkg",
    "dependencies",
    "yarnlock",
    "node-modules",
    "packages",
    "package"
  ],
  "homepage": "https://github.com/bluelovers/ws-yarn-workspaces#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-yarn-workspaces/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-yarn-workspaces.git"
  },
  "workspaces": [
    "packages/@yarn-tool/*",
    "packages/@lazy-node/*",
    "packages/*"
  ],
  "scripts": {
    "review:all": "lerna run review --concurrency 1",
    "review:since": "node --run review:all -- --since",
    "coverage:all": "lerna run coverage --concurrency 1",
    "coverage:since": "node --run coverage:all -- --since",
    "lint:all": "lerna run lint --concurrency 1",
    "lint:since": "node --run lint:all -- --since",
    "pretest": "echo pretest",
    "test": "node --run test:since",
    "test:all": "yarn-tool ws run test --concurrency 1",
    "test:jest:clearCache": "jest --clearCache",
    "test:since": "node --run test:all -- --since",
    "test:snapshot:all": "yarn-tool ws run test:snapshot --concurrency 1",
    "test:snapshot:since": "node --run test:snapshot:all -- --since",
    "test:tsd:all": "yarn-tool ws run test:tsd --concurrency 1",
    "test:tsd:since": "node --run test:tsd:all -- --since",
    "install:frozenLockfile": "yarn-tool install --frozen-lockfile",
    "install:reset-lockfile": "yarn-tool install --reset-lockfile",
    "install:resetLockfile": "yarn-tool install --reset-lockfile",
    "build:all": "lerna run build --concurrency 1",
    "build:since": "node --run build:all -- --since",
    "ci:install": "yarn install --frozen-lockfile && yarn add -W typescript@next jest ts-jest ts-node ynpx lerna yarn-tool pnpm",
    "ci:install:pnpm": "pnpm install --frozen-lockfile && pnpm add --workspace yarn-tool lerna ynpx pnpm typescript ts-node tsx ts-jest jest @bluelovers/jest-config @bluelovers/tsconfig @yarn-tool/require-resolve",
    "ci:install:yarn": "yarn install --frozen-lockfile && yarn add -W yarn-tool lerna ynpx pnpm typescript ts-node tsx ts-jest jest @bluelovers/jest-config @bluelovers/tsconfig @yarn-tool/require-resolve",
    "ci:build": "echo ci:build",
    "lerna:publish": "node --run prepublishOnly:root && lerna publish --no-private && pnpm run postpublishOnly",
    "lerna:publish:yes": "node --run lerna:publish:yes:patch",
    "lerna:publish:yes:force": "lerna publish --no-private --yes --bump patch --force-publish",
    "lerna:publish:yes:major": "node --run prepublishOnly:root && lerna publish --no-private --yes --bump major && pnpm run postpublishOnly",
    "lerna:publish:yes:minor": "node --run prepublishOnly:root && lerna publish --no-private --yes --bump minor && pnpm run postpublishOnly",
    "lerna:publish:yes:patch": "node --run prepublishOnly:root && lerna publish --no-private --yes --bump patch && pnpm run postpublishOnly",
    "ws:fix-all": "ts-node ./test/scripts/fix-all.ts",
    "ws:fix-all:resetStaticFiles": "node --run ws:fix-all -- --resetStaticFiles",
    "preversion": "pnpm run test",
    "version": "echo version",
    "postversion": "ts-node ./test/scripts/fix-all.ts",
    "prepublish": "echo prepublish",
    "prepublish:lockfile": "ynpx sync-lockfile",
    "prepare": "echo prepare",
    "prepare:fix-ws-links": "echo ynpx @yarn-tool/fix-ws-links",
    "prepublishOnly": "echo prepublishOnly",
    "prepublishOnly:check-bin": "ynpx --quiet @yarn-tool/check-pkg-bin",
    "prepublishOnly:lockfile": "ynpx --quiet sync-lockfile",
    "prepublishOnly:root": "node --run prepublishOnly:check-bin && node --run prepare:fix-ws-links",
    "prepublishOnly:update": "pnpm run ncu && pnpm run sort-package-json",
    "prepack": "echo prepack",
    "pack": "echo pack",
    "postpack": "echo postpack",
    "publish": "echo publish",
    "postpublish": "node --run postpublishOnly:ws-root-changelog",
    "postpublish:subrepo": "git subrepo push --all & git push",
    "postpublishOnly": "node --run postpublishOnly:ws-root-changelog & echo postpublishOnly",
    "postpublishOnly:ws-root-changelog": "ynpx ws-root-changelog & git commit ./CHANGELOG.md -m \"chore(changelog): update changelog toc in workspaces root\" & echo update changelog toc in workspaces root",
    "ncu": "node --run ncu:ws",
    "ncu:ws": "yarn-tool ncu -u --AA",
    "ncu:root": "yarn-tool ncu -u",
    "sort-package-json": "node --run sort-package-json:root && node --run sort-package-json:ws",
    "sort-package-json:root": "yarn-tool sort",
    "sort-package-json:ws": "yarn-tool ws exec yarn-tool sort",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "@bluelovers/conventional-changelog-bluelovers": "^5.0.27",
    "@lerna/conventional-commits": "^6.4.1",
    "@yarn-tool/fix-all": "^3.0.16",
    "@yarn-tool/get-global-dirs": "^1.0.5",
    "array-hyper-unique": "^2.1.8",
    "bluebird": "^3.7.2",
    "chalk": "< 3 >= 2",
    "crlf-normalize": "^1.0.20",
    "debug-color2": "^1.3.2",
    "fs-extra": "^11.4.0",
    "inquirer": "< 9 >= 8.2.4",
    "jest-console": "^0.1.0",
    "level": "^10.0.0",
    "micromatch": "^4.0.8",
    "package-json": "<7 >=6.5",
    "path-is-same": "^1.0.29",
    "pkg-up": "< 4 >= 3.1.0",
    "semver": "^7.8.5",
    "strip-ansi": "<7 >=6.0.1",
    "ts-node": "^10.9.2",
    "ts-type": "^3.0.13",
    "tslib": ">=2.8.1",
    "upath2": "^3.1.25",
    "yargs": "<18 >=17.7.2"
  },
  "devDependencies": {
    "@bluelovers/fast-glob": "^3.0.4",
    "@bluelovers/jest-config": "^1.1.11",
    "@bluelovers/tsconfig": "^2.0.3",
    "@types/bluebird": "^3.5.42",
    "@types/chai": "^5.2.3",
    "@types/chalk": "^2.2.4",
    "@types/cli-table": "^0.3.4",
    "@types/conventional-changelog": "^6.0.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/debug": "^4.1.13",
    "@types/err-code": "^2.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/hash-sum": "^1.0.2",
    "@types/inquirer": "^9.0.10",
    "@types/jest": "^30.0.0",
    "@types/json5": "^0.0.30",
    "@types/jsonfile": "^6.1.4",
    "@types/level": "^6.0.3",
    "@types/lodash": "^4.17.25",
    "@types/micromatch": "^4.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.1",
    "@types/npm-package-arg": "^6.1.4",
    "@types/npm-packlist": "^7.0.3",
    "@types/parse-git-config": "^3.0.4",
    "@types/semver": "^7.8.0",
    "@types/tar": "^6.1.13",
    "@types/tmp": "^0.2.6",
    "@types/update-notifier": "<6 >=5.1.0",
    "@types/validate-npm-package-name": "^4.0.2",
    "@types/yargs": "^17.0.35",
    "@types/yarnpkg__lockfile": "^1.1.9",
    "@types/yawn-yaml": "^1.4.2",
    "@yarn-tool/require-resolve": "*",
    "@yarn-tool/ws-find-up-paths": "^1.0.21",
    "chai": "<5 >=4.4.1",
    "jest": "^30.5.1",
    "jest-console": "^0.1.0",
    "mocha": "^12.0.0",
    "ts-jest": "^29.4.12"
  }
}
