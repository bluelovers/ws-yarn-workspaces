{
  "name": "find-pkg-ws",
  "version": "1.0.54",
  "description": "find yarn workspaces package.json",
  "keywords": [
    "init",
    "lerna",
    "npm",
    "workspace",
    "workspaces",
    "yarn"
  ],
  "homepage": "https://github.com/bluelovers/ws-yarn-workspaces/tree/master/packages/find-pkg-ws#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-yarn-workspaces/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-yarn-workspaces.git",
    "directory": "packages/find-pkg-ws"
  },
  "license": "ISC",
  "author": "",
  "main": "index.js",
  "scripts": {
    "coverage": "npx nyc npm run test",
    "test": "node --run test:node",
    "test:jest": "jest --passWithNoTests",
    "test:jest:coverage": "pnpm run test:jest -- --coverage",
    "test:jest:snapshot": "pnpm run test:jest -- -u",
    "test:node": "tsx --test --test-update-snapshots test/**/*.node-spec.ts test/**/*.node-test.ts test/**/*.spec.ts test/**/*.test.ts",
    "test:snapshot": "pnpm run test -u",
    "test:tsc": "tsc --noEmit & echo typescript check done",
    "test:tsd": "ynpx tsd",
    "preversion": "pnpm run test",
    "prepublishOnly": "echo prepublishOnly",
    "ncu": "npx yarn-tool ncu -u",
    "sort-package-json": "npx yarn-tool sort",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "find-yarn-workspace-root2": "^1.2.55"
  },
  "gitHead": "40676553ac196265d354e537459d4c78d67f0a8c"
}
