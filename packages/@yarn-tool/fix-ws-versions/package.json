{
  "name": "@yarn-tool/fix-ws-versions",
  "version": "3.0.10",
  "description": "自動同步和修復 monorepo workspace 中的套件版本依賴 (Auto sync and fix package version dependencies in monorepo workspaces)",
  "keywords": [
    "workspaces",
    "fix-versions",
    "sync-versions",
    "dependencies",
    "monorepo",
    "yarn",
    "npm",
    "lerna",
    "semver",
    "version",
    "pkg",
    "yarnlock",
    "node-modules",
    "packages",
    "package",
    "yarn-tool",
    "create-by-yarn-tool"
  ],
  "homepage": "https://github.com/bluelovers/ws-yarn-workspaces/tree/master/packages/@yarn-tool/fix-ws-versions#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-yarn-workspaces/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-yarn-workspaces.git",
    "directory": "packages/@yarn-tool/fix-ws-versions"
  },
  "license": "ISC",
  "author": "bluelovers",
  "sideEffects": false,
  "main": "index.js",
  "scripts": {
    "review": "pnpm run review:coverage",
    "review:coverage": "pnpm run lint && pnpm run coverage",
    "review:test": "pnpm run lint && pnpm run test",
    "coverage": "pnpm run test -- --coverage",
    "lint": "pnpm run lint:eslint",
    "lint:eslint": "ynpx eslint --ext .ts,.tsx,.mts,.cts ./",
    "pretest": "echo pretest",
    "test": "jest --passWithNoTests",
    "test:jest": "jest --passWithNoTests",
    "test:jest:coverage": "pnpm run test:jest -- --coverage",
    "test:jest:snapshot": "pnpm run test:jest -- -u",
    "test:mocha": "ynpx --quiet -p ts-node -p mocha mocha -- --require ts-node/register \"!(node_modules)/**/*.{test,spec}.{ts,tsx}\"",
    "test:snapshot": "pnpm run test -u",
    "test:tsd": "ynpx tsd",
    "test:tsdx": "ynpx @bluelovers/tsdx test --passWithNoTests",
    "build:dts:bundle": "ynpx @bluelovers/dts-bundle-generator -o ./dist/index.d.ts ./src/index.ts --no-banner --inline-declare-global & echo build:dts:bundle",
    "build:dts:copy": "copy .\\src\\index.d.ts .\\dist\\index.d.ts & echo build:dts",
    "build:dts:tsc": "pnpm run build:dts:tsc:emit && pnpm run build:dts:copy",
    "build:dts:tsc:emit": "tsc --emitDeclarationOnly --declaration --noEmit false",
    "build:microbundle": "ynpx microbundle --target node",
    "build:tsdx": "ynpx @bluelovers/tsdx build --target node --name index",
    "ci:install": "echo ci:install",
    "ci:build": "echo ci:build",
    "preversion": "echo preversion && pnpm run test",
    "version": "echo version",
    "postversion": "echo postversion",
    "prepublish": "echo prepublish",
    "prepare": "echo prepare",
    "prepublishOnly": "echo prepublishOnly",
    "prepublishOnly:update": "pnpm run ncu && pnpm run sort-package-json",
    "prepack": "echo prepack",
    "pack": "echo pack",
    "postpack": "echo postpack",
    "publish": "echo publish",
    "postpublish": "echo postpublish",
    "postpublishOnly": "echo postpublishOnly",
    "ncu": "yarn-tool ncu -u",
    "sort-package-json": "yarn-tool sort",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "@lazy-node/semver-simple-parse": "^4.0.7",
    "@ts-type/package-dts": "^3.0.9",
    "tslib": ">=2.8.1",
    "ws-pkg-list": "^3.0.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "46d4d576f34d2d5218822811286119ea7a44d08b"
}
