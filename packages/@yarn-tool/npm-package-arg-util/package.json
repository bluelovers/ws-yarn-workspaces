{
  "name": "@yarn-tool/npm-package-arg-util",
  "version": "2.0.11",
  "description": "A utility library for parsing and handling npm package arguments, providing enhanced functionality for yarn tools / 用於解析和處理 npm 套件參數的工具函式庫，為 yarn 工具提供增強功能",
  "keywords": [
    "yarn",
    "yarn-tool",
    "npm",
    "npm-package-arg",
    "npa",
    "package-argument",
    "package-parser",
    "lerna",
    "workspaces",
    "monorepo",
    "pkg",
    "dependencies",
    "packages",
    "package",
    "semver",
    "version",
    "typescript",
    "types"
  ],
  "homepage": "https://github.com/bluelovers/ws-yarn-workspaces/tree/master/packages/@yarn-tool/npm-package-arg-util#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-yarn-workspaces/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-yarn-workspaces.git",
    "directory": "packages/@yarn-tool/npm-package-arg-util"
  },
  "license": "ISC",
  "author": "bluelovers",
  "main": "index.js",
  "scripts": {
    "coverage": "pnpm run test --coverage",
    "test": "node --run test:node",
    "test:jest": "jest --passWithNoTests",
    "test:jest:coverage": "pnpm run test:jest --coverage",
    "test:jest:snapshot": "pnpm run test:jest -u",
    "test:node": "tsx --test --test-update-snapshots **/*.node-spec.ts **/*.node-test.ts **/*.spec.ts **/*.test.ts",
    "test:node:bin": "tsx --test --test-update-snapshots --",
    "test:node:bin:coverage": "node --run test:node:bin -- --experimental-test-coverage --",
    "test:snapshot": "pnpm run test -u",
    "test:tsc": "tsc --noEmit & echo typescript check done",
    "test:tsc:sub": "cd test && tsc --noEmit & echo Type checking completed (test)",
    "test:tsd": "ynpx tsd",
    "preversion": "pnpm run test",
    "prepublishOnly": "echo prepublishOnly",
    "prepublishOnly:check-bin": "@yarn-tool/check-pkg-bin",
    "prepublishOnly:update": "pnpm run ncu && pnpm run sort-package-json",
    "ncu": "yarn-tool ncu -u",
    "sort-package-json": "yarn-tool sort",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "@types/npm-package-arg": "*",
    "@yarn-tool/pkg-name-util": "^1.0.15",
    "npm-package-arg": "^14.0.0",
    "ts-type": "^3.0.18",
    "tslib": ">=2.8.1"
  },
  "engines": {
    "node": ">=16.14.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
