{
  "name": "@yarn-tool/init-path",
  "version": "2.0.14",
  "description": "計算 Yarn Workspaces 環境中套件初始化的目標路徑 / Calculate target path for package initialization in Yarn Workspaces environment",
  "keywords": [
    "yarn",
    "yarn-workspaces",
    "workspaces",
    "monorepo",
    "init",
    "initialization",
    "package",
    "target-path",
    "path",
    "npm"
  ],
  "homepage": "https://github.com/bluelovers/ws-yarn-workspaces/tree/master/packages/@yarn-tool/init-path#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-yarn-workspaces/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-yarn-workspaces.git",
    "directory": "packages/@yarn-tool/init-path"
  },
  "license": "ISC",
  "author": "bluelovers",
  "main": "index.js",
  "scripts": {
    "coverage": "pnpm run test -- --coverage",
    "lint": "ynpx --quiet eslint -- **/*.ts",
    "test": "node --run test:node",
    "test:jest": "ynpx --quiet jest -- --coverage",
    "test:jest:coverage": "pnpm run test:jest -- --coverage",
    "test:jest:snapshot": "pnpm run test:jest -- -u",
    "test:mocha": "ynpx --quiet -p ts-node -p mocha mocha -- --require ts-node/register \"!(node_modules)/**/*.{test,spec}.{ts,tsx}\"",
    "test:node": "tsx --test --test-update-snapshots **/*.node-spec.ts **/*.node-test.ts **/*.spec.ts **/*.test.ts",
    "test:node:bin": "tsx --test --test-update-snapshots --",
    "test:node:bin:coverage": "node --run test:node:bin -- --experimental-test-coverage --",
    "test:snapshot": "pnpm run test -u",
    "test:tsc": "tsc --noEmit & echo typescript check done",
    "test:tsc:sub": "cd test && tsc --noEmit & echo Type checking completed (test)",
    "test:tsd": "ynpx tsd",
    "preversion": "pnpm run test",
    "prepublishOnly": "echo prepublishOnly",
    "prepublishOnly:check-bin": "ynpx --quiet @yarn-tool/check-pkg-bin",
    "prepublishOnly:update": "pnpm run ncu && pnpm run sort-package-json",
    "ncu": "yarn-tool ncu -u",
    "sort-package-json": "yarn-tool sort",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "@yarn-tool/search-workspace-prefix-by-name": "^2.0.14",
    "@yarn-tool/validate-npm-package-name": "^3.0.28",
    "fs-extra": "^11.4.1",
    "tslib": ">=2.8.1",
    "workspaces-config": "^2.0.14"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "67f2bf3be478106378700eb513da557943b2f9f3"
}
