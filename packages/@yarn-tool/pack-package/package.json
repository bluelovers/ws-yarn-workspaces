{
  "name": "@yarn-tool/pack-package",
  "version": "3.0.14",
  "description": "pack package, and print information about packed tar",
  "keywords": [
    "pack",
    "package",
    "tarball",
    "packed-tar",
    "npm-packlist"
  ],
  "homepage": "https://github.com/bluelovers/ws-yarn-workspaces/tree/master/packages/@yarn-tool/pack-package#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-yarn-workspaces/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-yarn-workspaces.git",
    "directory": "packages/@yarn-tool/pack-package"
  },
  "license": "ISC",
  "author": "bluelovers",
  "main": "index.js",
  "scripts": {
    "coverage": "pnpm run test -- --coverage",
    "test": "node --run test:node",
    "test:jest": "jest --passWithNoTests",
    "test:jest:coverage": "pnpm run test:jest -- --coverage",
    "test:jest:snapshot": "pnpm run test:jest -- -u",
    "test:node": "tsx --test --test-update-snapshots **/*.node-spec.ts **/*.node-test.ts **/*.spec.ts **/*.test.ts",
    "test:snapshot": "pnpm run test -u",
    "test:tsc": "tsc --noEmit & echo typescript check done",
    "test:tsd": "ynpx tsd",
    "npm:publish": "npm publish",
    "preversion": "pnpm run test",
    "ncu": "npx yarn-tool ncu -u",
    "sort-package-json": "npx yarn-tool sort",
    "tsc:default": "tsc -p tsconfig.json",
    "tsc:esm": "tsc -p tsconfig.esm.json",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "@lerna/get-packed": "^6.4.1",
    "@lerna/log-packed": "^6.4.1",
    "@npmcli/arborist": "^10.0.3",
    "@ts-type/package-dts": "^3.0.14",
    "npm-packlist": "^11.3.0",
    "tar": "^7.5.22",
    "tslib": ">=2.8.1"
  },
  "devDependencies": {
    "@yarn-tool/require-resolve": "^4.0.11",
    "@yarn-tool/script-lifecycle": "^2.0.19"
  },
  "engines": {
    "node": ">=16.14.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "46d4d576f34d2d5218822811286119ea7a44d08b"
}
