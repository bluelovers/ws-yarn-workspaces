{
  "name": "@yarn-tool/version-recommended",
  "version": "3.0.19",
  "description": "Recommend the next semver version: auto-detect bump type and pre-release identifiers from an old version, with yarn workspaces / monorepo support",
  "keywords": [
    "semver",
    "version",
    "bump",
    "next-version",
    "recommend",
    "prerelease",
    "release",
    "increment",
    "monorepo",
    "workspaces",
    "yarn",
    "yarn-tool",
    "pnpm",
    "npm"
  ],
  "homepage": "https://github.com/bluelovers/ws-yarn-workspaces/tree/master/packages/@yarn-tool/version-recommended#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-yarn-workspaces/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-yarn-workspaces.git",
    "directory": "packages/@yarn-tool/version-recommended"
  },
  "license": "ISC",
  "author": "bluelovers",
  "main": "index.js",
  "scripts": {
    "coverage": "pnpm run test -- --coverage",
    "lint": "ynpx --quiet eslint -- **/*.ts",
    "test": "node --run test:node",
    "test:jest": "ynpx --quiet jest -- --coverage",
    "test:jest:coverage": "pnpm run test:jest -- --coverage",
    "test:jest:snapshot": "pnpm run test:jest -- -u",
    "test:mocha": "ynpx --quiet -p ts-node -p mocha mocha -- --require ts-node/register \"!(node_modules)/**/*.{test,spec}.{ts,tsx}\"",
    "test:node": "tsx --test --test-update-snapshots **/*.node-spec.ts **/*.node-test.ts **/*.spec.ts **/*.test.ts",
    "test:snapshot": "pnpm run test -u",
    "test:tsc": "tsc --noEmit & echo typescript check done",
    "test:tsd": "ynpx tsd",
    "preversion": "pnpm run test",
    "prepublishOnly": "echo prepublishOnly",
    "prepublishOnly:check-bin": "ynpx --quiet @yarn-tool/check-pkg-bin",
    "prepublishOnly:update": "pnpm run ncu && pnpm run sort-package-json",
    "ncu": "ynpx --quiet yarn-tool -- ncu -u",
    "sort-package-json": "ynpx --quiet yarn-tool -- sort",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "@ts-type/package-dts": "^3.0.14",
    "@types/semver": "*",
    "@yarn-tool/find-root": "^2.0.27",
    "@yarn-tool/types": "^1.0.23",
    "@yarn-tool/workspaces-project": "^3.0.18",
    "semver": "^7.8.5",
    "ts-type": "^3.0.18",
    "tslib": ">=2.8.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "46d4d576f34d2d5218822811286119ea7a44d08b"
}
