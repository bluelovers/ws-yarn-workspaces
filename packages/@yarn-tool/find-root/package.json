{
  "name": "@yarn-tool/find-root",
  "version": "2.0.25",
  "description": "尋找 Yarn workspace 根目錄的工具，提供路徑驗證、錯誤處理和斷言函數 (Find Yarn workspace root directory with path validation, error handling, and assertion functions)",
  "keywords": [
    "monorepo",
    "workspace-root",
    "find-root",
    "pkg-dir",
    "package-root",
    "root-directory",
    "path-validation",
    "workspaces",
    "yarn",
    "yarn-tool",
    "npm",
    "pnpm",
    "lerna",
    "assertion"
  ],
  "homepage": "https://github.com/bluelovers/ws-yarn-workspaces/tree/master/packages/@yarn-tool/find-root#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-yarn-workspaces/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-yarn-workspaces.git",
    "directory": "packages/@yarn-tool/find-root"
  },
  "license": "ISC",
  "author": "bluelovers",
  "main": "index.js",
  "scripts": {
    "coverage": "npx nyc npm run test",
    "lint": "npx eslint **/*.ts",
    "test": "node --run test:jest --",
    "test:jest": "jest --passWithNoTests",
    "test:jest:coverage": "pnpm run test:jest -- --coverage",
    "test:jest:snapshot": "pnpm run test:jest -- -u",
    "test:snapshot": "pnpm run test -u",
    "test:tsd": "ynpx tsd",
    "preversion": "pnpm run test",
    "prepublishOnly": "echo prepublishOnly",
    "prepublishOnly_": "pnpm run prepublishOnly:check-bin && pnpm run test",
    "prepublishOnly:check-bin": "ynpx --quiet @yarn-tool/check-pkg-bin",
    "prepublishOnly:update": "pnpm run ncu && pnpm run sort-package-json",
    "postpublish_": "git commit -m \"publish new version\" .",
    "ncu": "npx yarn-tool ncu -u",
    "sort-package-json": "npx yarn-tool sort",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "@ts-type/package-dts": "^3.0.9",
    "err-code": "^3.0.1",
    "find-yarn-workspace-root2": "^1.2.55",
    "path-is-same": "^1.0.29",
    "pkg-dir": "<6 >=5",
    "tslib": ">=2.8.1",
    "upath2": "^3.1.25"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "46d4d576f34d2d5218822811286119ea7a44d08b"
}
