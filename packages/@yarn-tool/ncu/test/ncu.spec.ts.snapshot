exports[`should not update > * 1`] = `
{
  "json_old": {
    "devDependencies": {
      "@types/node": "*"
    }
  },
  "packageManager": "npm",
  "packageData": "{\\"devDependencies\\":{\\"@types/node\\":\\"*\\"}}",
  "jsonUpgraded": true,
  "json_new": {
    "devDependencies": {
      "@types/node": "*"
    }
  },
  "list_updated": {},
  "json_changed": false,
  "current": {}
}
`;

