{
  "name": "@yarn-tool/run-script-lifecycle",
  "version": "3.0.11",
  "description": "Execute npm/yarn lifecycle scripts with pre/post script support - 執行 npm/yarn 生命週期腳本，支援前置/後置腳本",
  "keywords": [
    "yarn",
    "yarn-tool",
    "lifecycle",
    "script",
    "npm",
    "run-script",
    "preinstall",
    "postinstall",
    "lifecycle-scripts",
    "package.json"
  ],
  "homepage": "https://github.com/bluelovers/ws-yarn-workspaces/tree/master/packages/@yarn-tool/run-script-lifecycle#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-yarn-workspaces/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-yarn-workspaces.git",
    "directory": "packages/@yarn-tool/run-script-lifecycle"
  },
  "license": "ISC",
  "author": "bluelovers",
  "main": "index.js",
  "scripts": {
    "coverage": "npx nyc pnpm run test",
    "lint": "npx eslint **/*.ts",
    "pretest": "echo pretest",
    "test": "jest --passWithNoTests",
    "test:jest": "jest --passWithNoTests",
    "test:jest:coverage": "pnpm run test:jest -- --coverage",
    "test:jest:snapshot": "pnpm run test:jest -- -u",
    "test:mocha": "ynpx --quiet -p ts-node -p mocha mocha -- --require ts-node/register \"!(node_modules)/**/*.{test,spec}.{ts,tsx}\"",
    "test:snapshot": "pnpm run test -u",
    "test:tsd": "ynpx tsd",
    "posttest": "echo posttest",
    "npm:publish": "npm publish",
    "preversion": "pnpm run test",
    "prepublish:lockfile": "npx sync-lockfile .",
    "prepublishOnly_": "pnpm run ncu && pnpm run sort-package-json && pnpm run test",
    "postpublish_": "git commit -m \"chore(release): publish\" .",
    "ncu": "npx yarn-tool ncu -u",
    "sort-package-json": "npx yarn-tool sort",
    "tsc:default": "tsc -p tsconfig.json",
    "tsc:esm": "tsc -p tsconfig.esm.json",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "@npmcli/run-script": "^11.0.0",
    "@ts-type/package-dts": "^3.0.9",
    "@yarn-tool/script-lifecycle": "^2.0.17",
    "read-package-json-fast": "^6.0.0",
    "tslib": ">=2.8.1"
  },
  "engines": {
    "node": ">=16.14.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "02f74c14e885366e9be773564ea43f7425f9d97a"
}
