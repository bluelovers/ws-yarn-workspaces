{
  "name": "@yarn-tool/changelog",
  "version": "3.0.14",
  "description": "Generate and update CHANGELOG.md using conventional commits for monorepo workspaces",
  "keywords": [
    "changelog",
    "conventional-commits",
    "lerna",
    "monorepo",
    "workspaces",
    "yarn",
    "yarn-tool",
    "semver",
    "release",
    "git",
    "cli"
  ],
  "homepage": "https://github.com/bluelovers/ws-yarn-workspaces/tree/master/packages/@yarn-tool/changelog#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-yarn-workspaces/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-yarn-workspaces.git",
    "directory": "packages/@yarn-tool/changelog"
  },
  "license": "ISC",
  "author": "bluelovers",
  "main": "index.js",
  "bin": {
    "changelog": "bin/changelog.js"
  },
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "coverage": "npx nyc pnpm run test",
    "lint": "npx eslint **/*.ts",
    "test": "node --run test:jest --",
    "test:jest": "jest --coverage",
    "test:jest:coverage": "pnpm run test:jest -- --coverage",
    "test:jest:snapshot": "pnpm run test:jest -- -u",
    "test:mocha": "npx mocha --require ts-node/register \"!(node_modules)/**/*.{test,spec}.{ts,tsx}\"",
    "test:snapshot": "pnpm run test -u",
    "test:tsd": "ynpx tsd",
    "npm:publish": "npm publish",
    "npm:publish:lerna": "lerna publish --yes --bump patch",
    "preversion": "pnpm run test",
    "prepublish:lockfile": "npx sync-lockfile .",
    "prepublishOnly_": "pnpm run ncu && pnpm run sort-package-json && pnpm run test",
    "postpublish_": "git commit -m \"chore(release): publish & git push & echo postpublish\" .",
    "ncu": "npx yarn-tool ncu -u",
    "sort-package-json": "npx yarn-tool sort",
    "tsc:default": "tsc -p tsconfig.json",
    "tsc:esm": "tsc -p tsconfig.esm.json",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "@bluelovers/conventional-changelog-bluelovers": "*",
    "@lerna/conventional-commits": "^6.4.1",
    "@yarn-tool/find-root": "^2.0.25",
    "@yarn-tool/require-resolve": "^4.0.9",
    "@yarn-tool/semver-diff": "^2.0.21",
    "@yarn-tool/table": "^2.0.22",
    "@yarn-tool/types": "^1.0.21",
    "lodash": "^4.18.1",
    "path-is-same": "^1.0.29",
    "ts-type": "^3.0.13",
    "tslib": ">=2.8.1",
    "upath2": "^3.1.25",
    "ws-pkg-list": "^3.0.11",
    "yargs": "<18 >=17.7.2"
  },
  "peerDependencies": {
    "@bluelovers/conventional-changelog-bluelovers": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "46d4d576f34d2d5218822811286119ea7a44d08b"
}
