    "options": {
      "startCount": 2,
      "endCount": 0
    },
    "content": "\\n\\n*.log"
  },
  {
    "label": "startCount = -1 → 收斂到 0",
    "options": {
      "startCount": -1,
      "endCount": 0
    },
    "content": "*.log"
  },
  {
    "label": "startCount = 上限 + 1 → 收斂到上限",
