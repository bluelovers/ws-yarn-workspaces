{
  "name": "@yarn-tool/check-pkg-bin",
  "version": "4.0.14",
  "description": "check pkg bin has shebang",
  "keywords": [
    "shebang",
    "bin",
    "check",
    "package.json",
    "workspaces"
  ],
  "homepage": "https://github.com/bluelovers/ws-yarn-workspaces/tree/master/packages/@yarn-tool/check-pkg-bin#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-yarn-workspaces/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-yarn-workspaces.git",
    "directory": "packages/@yarn-tool/check-pkg-bin"
  },
  "license": "ISC",
  "author": "bluelovers",
  "main": "index.js",
  "bin": {
    "check-pkg-bin": "bin/check-pkg-bin.js"
  },
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "coverage": "pnpm run test --coverage",
    "test": "node --run test:node",
    "test:jest": "jest --coverage",
    "test:jest:coverage": "pnpm run test:jest -- --coverage",
    "test:jest:snapshot": "pnpm run test:jest -- -u",
    "test:mocha": "ynpx mocha --require ts-node/register \"!(node_modules)/**/*.{test,spec}.{ts,tsx}\"",
    "test:node": "tsx --test --test-update-snapshots **/*.node-spec.ts **/*.node-test.ts **/*.spec.ts **/*.test.ts",
    "test:snapshot": "pnpm run test -u",
    "test:tsc": "tsc --noEmit & echo typescript check done",
    "test:tsd": "ynpx tsd",
    "npm:publish": "npm publish",
    "npm:publish:lerna": "lerna publish --yes --bump patch",
    "preversion": "pnpm run test",
    "bin:self": "tsx bin/check-pkg-bin.ts --workspaces",
    "sort-package-json": "npx yarn-tool sort",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "@bluelovers/string-natural-compare": "^2.0.17",
    "@ts-type/package-dts": "^3.0.14",
    "@yarn-tool/find-root": "^2.0.27",
    "@yarn-tool/get-pkg-bin": "^3.0.14",
    "@yarn-tool/shebang": "^1.0.26",
    "@yarn-tool/table": "^2.0.24",
    "cli-table3": "^0.6.5",
    "debug-color2": "^1.3.2",
    "fs-extra": "^11.4.1",
    "pkg-dir": "<6 >=5",
    "string-natural-compare2": "^3.0.1",
    "tslib": ">=2.8.1",
    "upath2": "^3.1.25",
    "ws-pkg-list": "^3.0.13",
    "yargs": "<18 >=17.7.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "46d4d576f34d2d5218822811286119ea7a44d08b"
}
