{
  "name": "@yarn-tool/static-file",
  "version": "3.0.19",
  "description": "用於將靜態設定檔案 (static configuration files) 複製到 yarn 工作區專案的工具 / A utility for copying static configuration files to yarn workspace projects",
  "keywords": [
    "static-file",
    "static-files",
    "static-templates",
    "copy-static-files",
    "config-files",
    "template",
    "templates",
    "yarn-workspace",
    "workspace",
    "gitignore",
    "npmignore",
    "tsconfig"
  ],
  "homepage": "https://github.com/bluelovers/ws-yarn-workspaces/tree/master/packages/@yarn-tool/static-file#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-yarn-workspaces/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-yarn-workspaces.git",
    "directory": "packages/@yarn-tool/static-file"
  },
  "license": "ISC",
  "author": "",
  "main": "index.js",
  "scripts": {
    "coverage": "pnpm run test --coverage",
    "test": "node --run test:jest --",
    "test:jest": "jest --passWithNoTests",
    "test:jest:coverage": "pnpm run test:jest -- --coverage",
    "test:jest:snapshot": "pnpm run test:jest -- -u",
    "test:snapshot": "pnpm run test -u",
    "test:tsd": "ynpx tsd",
    "npm:publish": "npm publish",
    "preversion": "pnpm run test",
    "prepublishOnly": "node --run fix:ignore",
    "fix:ignore": "tsx test/scripts/update-npmignore-static-files.ts",
    "ncu": "yarn-tool ncu -u",
    "sort-package-json": "yarn-tool sort",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "fs-extra": "^11.4.1",
    "tslib": ">=2.8.1"
  },
