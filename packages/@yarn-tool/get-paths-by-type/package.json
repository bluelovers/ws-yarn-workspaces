{
  "name": "@yarn-tool/get-paths-by-type",
  "version": "2.0.23",
  "description": "根據類型 Symbol 取得對應的路徑陣列（支援全域 npm/yarn 路徑） / Get corresponding path array based on type Symbol (supports global npm/yarn paths)",
  "keywords": [
    "yarn-tool",
    "get-paths",
    "global-dirs",
    "global-paths",
    "symbol",
    "path-resolver",
    "npm-global",
    "yarn-global",
    "yarn",
    "npm",
    "workspaces",
    "monorepo",
    "node-modules",
    "packages",
    "package"
  ],
  "homepage": "https://github.com/bluelovers/ws-yarn-workspaces/tree/master/packages/@yarn-tool/get-paths-by-type#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-yarn-workspaces/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-yarn-workspaces.git",
    "directory": "packages/@yarn-tool/get-paths-by-type"
  },
  "license": "ISC",
  "author": "bluelovers",
  "main": "index.js",
  "scripts": {
    "coverage": "pnpm run test -- --coverage",
    "lint": "ynpx --quiet eslint -- **/*.ts",
    "test": "node --run test:node",
    "test:jest": "jest --passWithNoTests",
    "test:jest:coverage": "pnpm run test:jest -- --coverage",
    "test:jest:snapshot": "pnpm run test:jest -- -u",
    "test:mocha": "ynpx --quiet -p ts-node -p mocha mocha -- --require ts-node/register \"!(node_modules)/**/*.{test,spec}.{ts,tsx}\"",
    "test:node": "tsx --test --test-update-snapshots **/*.node-spec.ts **/*.node-test.ts **/*.spec.ts **/*.test.ts",
    "test:node:bin": "tsx --test --test-update-snapshots --",
    "test:node:bin:coverage": "node --run test:node:bin -- --experimental-test-coverage --",
    "test:snapshot": "pnpm run test -u",
    "test:tsc": "tsc --noEmit & echo typescript check done",
    "test:tsc:sub": "cd test && tsc --noEmit & echo Type checking completed (test)",
    "test:tsd": "ynpx tsd",
    "preversion": "echo preversion && pnpm run test",
    "prepublishOnly:update": "pnpm run ncu && pnpm run sort-package-json",
    "ncu": "yarn-tool ncu -u",
    "sort-package-json": "yarn-tool sort",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "@yarn-tool/fnm-detect": "^1.0.12",
    "@yarn-tool/get-global-dirs": "^1.0.10",
    "tslib": ">=2.8.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
