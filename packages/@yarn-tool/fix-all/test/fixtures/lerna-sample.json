{
  "packages": [
    "packages/*"
  ],
  "command": {
    "publish": {
      "concurrency": 1,
      "loglevel": "verbose",
      "ignoreChanges": [
        "*.log",
        "*.tmp"
      ]
    },
    "version": {
      "concurrency": 1,
      "conventionalCommits": false
    }
  },
  "npmClient": "yarn",
  "useWorkspaces": true,
  "version": "independent"
}
