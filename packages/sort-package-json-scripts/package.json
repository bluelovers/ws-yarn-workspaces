{
  "name": "sort-package-json-scripts",
  "version": "1.1.34",
  "description": "Sort package.json scripts field following npm lifecycle scripts order with script grouping (pre/post) support / 排序 package.json scripts 欄位，遵循 npm 生命週期腳本順序，支援腳本分組 (pre/post)",
  "keywords": [
    "npm",
    "package-json",
    "scripts",
    "sort",
    "sort-json",
    "sort-object-keys",
    "lifecycle",
    "pre",
    "post"
  ],
  "homepage": "https://github.com/bluelovers/ws-yarn-workspaces/tree/master/packages/sort-package-json-scripts#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-yarn-workspaces/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-yarn-workspaces.git",
    "directory": "packages/sort-package-json-scripts"
  },
  "license": "ISC",
  "author": "bluelovers",
  "main": "index.js",
  "scripts": {
    "coverage": "npx nyc pnpm run test",
    "lint": "npx eslint **/*.ts",
    "test": "echo jest",
    "test:jest": "jest --passWithNoTests",
    "test:jest:coverage": "pnpm run test:jest -- --coverage",
    "test:jest:snapshot": "pnpm run test:jest -- -u",
    "test:mocha": "npx mocha --require ts-node/register \"!(node_modules)/**/*.{test,spec}.{ts,tsx}\"",
    "test:snapshot": "pnpm run test -u",
    "test:tsd": "ynpx tsd",
    "test:update-snapshots": "jest -u",
    "npm:publish": "npm publish",
    "preversion": "pnpm run test",
    "prepublish:lockfile": "npx sync-lockfile .",
    "prepublishOnly": "echo prepublishOnly",
    "postpublish_": "git commit -m \"chore(release): publish\" .",
    "ncu": "npx yarn-tool ncu -u",
    "sort-package-json": "npx yarn-tool sort",
    "tsc:default": "tsc -p tsconfig.json",
    "tsc:esm": "tsc -p tsconfig.esm.json",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "sort-object-keys2": "^3.0.8",
    "tslib": ">=2.8.1"
  },
  "gitHead": "46d4d576f34d2d5218822811286119ea7a44d08b"
}
