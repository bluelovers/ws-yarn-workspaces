  },
  "fnOrder": [
    "findEnvCachePath",
    "findPkgModulePath",
    "findYarnCachePath",
    "findNpmCachePath",
    "findOSTempPath"
  ]
}
`;

exports[`handleOptions > disableDefaultFailback 不接兜底順序 / no fallback order appended 1`] = `
