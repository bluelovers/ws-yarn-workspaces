{
  "name": "ws-root-spawn",
  "version": "1.0.56",
  "description": "run/exec a command in the workspaces root directory (yarn / npm / lerna)",
  "keywords": [
    "workspaces",
    "workspace-root",
    "run",
    "exec",
    "spawn",
    "monorepo",
    "yarn",
    "npm",
    "cross-spawn",
    "cli"
  ],
  "homepage": "https://github.com/bluelovers/ws-yarn-workspaces/tree/master/packages/ws-root-run#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-yarn-workspaces/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-yarn-workspaces.git",
    "directory": "packages/ws-root-run"
  },
  "license": "ISC",
  "author": "bluelovers",
  "main": "index.js",
  "bin": {
    "ws-root-spawn": "bin/ws-root.js"
  },
  "scripts": {
    "coverage": "pnpm run test --coverage",
    "test": "node --run test:node",
    "test:jest": "jest --coverage",
    "test:jest:coverage": "node --run test:jest -- --coverage",
    "test:jest:snapshot": "node --run test:jest -- -u",
    "test:node": "tsx --test --test-update-snapshots **/*.node-spec.ts **/*.node-test.ts **/*.spec.ts **/*.test.ts",
    "test:snapshot": "pnpm run test -u",
    "test:tsc": "tsc --noEmit & echo typescript check done",
    "test:tsd": "ynpx tsd",
    "npm:publish": "npm publish",
    "npm:publish:lerna": "lerna publish --yes",
    "preversion": "pnpm run test",
    "ncu": "yarn-tool ncu -u",
    "sort-package-json": "yarn-tool sort",
    "tsc:default": "tsc -p tsconfig.json",
    "tsc:esm": "tsc -p tsconfig.esm.json",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "cross-spawn-extra": "^3.0.3",
    "find-yarn-workspace-root2": "^1.2.55",
    "tslib": ">=2.8.1"
  },
  "gitHead": "40676553ac196265d354e537459d4c78d67f0a8c"
}
