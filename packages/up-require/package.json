{
  "name": "up-require",
  "version": "3.0.8",
  "description": "Require package module from highest or list of module.",
  "keywords": [
    "export",
    "exports",
    "highest",
    "module",
    "modules",
    "package",
    "parent",
    "parent-require",
    "parents",
    "pkg",
    "require",
    "resolve"
  ],
  "homepage": "https://github.com/bluelovers/ws-yarn-workspaces/tree/master/packages/up-require#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-yarn-workspaces/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-yarn-workspaces.git",
    "directory": "packages/up-require"
  },
  "license": "ISC",
  "author": "bluelovers",
  "main": "./index",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "coverage": "pnpm run test -- --coverage",
    "test": "node --run test:node",
    "test:jest": "jest --passWithNoTests",
    "test:jest:coverage": "pnpm run test:jest",
    "test:jest:snapshot": "pnpm run test -u",
    "test:node": "tsx --test --test-update-snapshots **/*.node-spec.ts **/*.node-test.ts **/*.spec.ts **/*.test.ts",
    "test:snapshot": "pnpm run test -u",
    "test:tsc": "tsc --noEmit & echo typescript check done",
    "test:tsd": "ynpx tsd",
    "preversion": "pnpm run test",
    "prepublishOnly:update": "pnpm run ncu && pnpm run sort-package-json",
    "ncu": "yarn-tool ncu -u",
    "sort-package-json": "yarn-tool sort",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "tslib": ">=2.8.1"
  }
}
